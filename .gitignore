# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# leftover Next.js source -- couldn't be deleted from this session (likely
# file locks from VS Code/the dev server); safe to delete by hand later,
# gitignored here so they never get committed either way
/app
/components
/html-site
/_archive_delete_me

# typescript
*.tsbuildinfo
next-env.d.ts
